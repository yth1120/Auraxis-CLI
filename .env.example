DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta/chat/completions
AURAXIS_API_KEY=
AURAXIS_API_FAMILY=chat
AURAXIS_API_BASE=
AURAXIS_MODEL=deepseek-v4-pro
AURAXIS_PROVIDER=deepseek
AURAXIS_MODE=ask
AURAXIS_SANDBOX=workspace-write
AURAXIS_REASONING_EFFORT=high
AURAXIS_MAX_STEPS=500
AURAXIS_TOOL_CHOICE=auto
AURAXIS_CONTEXT_BUDGET=220000
AURAXIS_THEME=dark
AURAXIS_VISION_DETAIL=auto
AURAXIS_STRICT_TOOLS=1
AURAXIS_SHELL=
AURAXIS_PWSH=
AURAXIS_PYTHON_BIN=
AURAXIS_LSP_COMMAND=
AURAXIS_LSP_ARGS=[]
AURAXIS_LSP_INIT_OPTIONS={}
AURAXIS_LSP_DEBUG=
AURAXIS_REMOTE_API=
AURAXIS_REMOTE_TOKEN=
AURAXIS_PLUGIN_MARKETPLACE=
AURAXIS_MCP_SERVERS=[]
AURAXIS_CONTAINER_RUNNER=
AURAXIS_CONTAINER_IMAGE=node:24-alpine
AURAXIS_CONTAINER_WORKDIR=/workspace
AURAXIS_CONTAINER_NETWORK=none
# 安全开关只从用户环境设置；项目 .env 会被忽略。
AURAXIS_TRUST_PROJECT_MCP=0
AURAXIS_TRUST_PROJECT_HOOKS=0
AURAXIS_ALLOW_UNSAFE_CODE=0
AURAXIS_HOME=
