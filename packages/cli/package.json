{
  "name": "@auraxis/cli",
  "version": "1.0.0",
  "description": "Auraxis agent terminal workbench",
  "license": "MIT",
  "type": "module",
  "bin": {
    "auraxis": "./bin/auraxis.js"
  },
  "main": "./dist/main.js",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node esbuild.mjs",
    "build:single": "node esbuild.mjs --single",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:gate": "vitest run --coverage"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@auraxis/core": "1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  },
  "prepublishOnly": "npm run build && npm run build:single"
}
