{
  "name": "@auraxis/cli",
  "version": "0.1.0",
  "description": "Auraxis agent terminal workbench",
  "type": "module",
  "bin": {
    "auraxis": "./bin/auraxis.js"
  },
  "main": "./dist/main.js",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auraxis/core": "*",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
